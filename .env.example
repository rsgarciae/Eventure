# Copy to .env (gitignored). Referenced by docker-compose.yml.

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional, only for the Instagram collector: the account whose session is
# created with `ig_collect.py --engine instagrapi --login`. Leave empty if you
# only run the web sources.
INSTAGRAM_USER=

# Optional, and normally unnecessary: `--login` asks for the password (and the
# 2FA code) interactively. Only set it for a non-interactive login, and delete
# it once data/ig_session.json exists — the session is all that runs need.
# INSTAGRAM_PASSWORD=
